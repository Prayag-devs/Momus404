# Mode switches (1 = simulate, 0 = real)
MOCK_LLM=1
MOCK_MCP=1
MOCK_LAYA=1
MOCK_VAULT=1

# ── Cloud LLMs ─────────────────────────────────────────────────────────────
# Nous Hermes via OpenRouter (or any OpenAI-compatible endpoint)
HERMES_BASE_URL=https://openrouter.ai/api/v1
HERMES_API_KEY=
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-405b

# OpenAI (self-healing + report generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Playwright MCP ─────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio          # stdio | http
MCP_COMMAND=npx @playwright/mcp@latest --headless
MCP_HTTP_URL=

# ── Jev AI Decision Engine ─────────────────────────────────────────────────
USE_JEV=1
JEV_API_KEY=
JEV_ENDPOINT=https://api.jev.ai/v1

# ── Orchestration ──────────────────────────────────────────────────────────
MAX_CONCURRENT_TESTS=2
MAX_HEAL_ATTEMPTS=2
STEP_TIMEOUT_S=30

# ── Vault ──────────────────────────────────────────────────────────────────
# Leave blank to auto-generate an ephemeral key on startup
VAULT_FERNET_KEY=

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/logs
